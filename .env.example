SECRET_KEY=replace-with-a-long-random-secret
# Generate separately: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=
# Comma-separated old Fernet keys, retained only during an MFA key rotation.
MFA_PREVIOUS_ENCRYPTION_KEYS=
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/careblue?sslmode=require
FACILITY_TIMEZONE=Asia/Kolkata
# Set to 0 to close self-service hospital onboarding.
REGISTRATION_ENABLED=1
S3_BUCKET=careblue-private
S3_ENDPOINT_URL=https://your-s3-compatible-endpoint
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
TRUSTED_HOSTS=your-project.vercel.app,your-domain.example
